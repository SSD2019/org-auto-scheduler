;;; 33-repeat-run-stability.el --- Running the scheduler twice gives the same schedule -*- lexical-binding: t -*-

;; Loaded by test/oas-suites-test.el; uses helpers from test/test-helper.el.

;; A plain run assigns a review order to every new task and saves it.  That
;; generated order must not be treated like an order the user chose in the
;; review buffer: otherwise the second run adds a "follow the saved order"
;; floor the first run did not have, and tasks that were backfilled into an
;; earlier gap jump to a later day.

(message "\n--- TEST 33: Repeat-Run Stability ---")

(defun t33-schedules (file)
  "Return (HEADING . SCHEDULED) for every scheduled entry in FILE."
  (with-current-buffer (find-file-noselect file)
    (let (acc)
      (org-map-entries
       (lambda ()
         (let ((s (org-entry-get nil "SCHEDULED")))
           (when s (push (cons (substring-no-properties (org-get-heading t t t t)) s) acc)))))
      (nreverse acc))))

(let* ((test-fixed-now (encode-time 0 0 8 5 1 2026)) ; Mon 08:00
       (temp-dir (make-temp-file "oas-t33-" t))
       (file (expand-file-name "demo.org" temp-dir))
       (org-agenda-files (list file)))
  (dolist (f (directory-files oas-test-state-dir t "\\`org-auto-scheduler-"))
    (delete-file f))
  (setq org-auto-scheduler--saved-review-decisions nil)
  (unwind-protect
      (progn
        (copy-file (expand-file-name "demo/demo-tasks.org" oas-test-root) file)
        (org-auto-scheduler-schedule-tasks)
        (let ((first (t33-schedules file)))
          (assert-true (cl-every (lambda (e) (plist-get (cdr e) :auto-order))
                                 org-auto-scheduler--saved-review-decisions)
                       "Test 33.1: Orders generated by a plain run are marked :auto-order")
          (org-auto-scheduler-schedule-tasks)
          (assert-equal (t33-schedules file) first
                        "Test 33.2: Second run leaves every task where the first run put it")
          (org-auto-scheduler-schedule-tasks)
          (assert-equal (t33-schedules file) first
                        "Test 33.3: Third run is still unchanged"))
        ;; An order saved from the review buffer is the user's and stays binding.
        (let ((org-auto-scheduler--preview-mode t))
          (org-auto-scheduler-schedule-tasks))
        (with-temp-buffer
          (org-auto-scheduler-review-mode)
          (setq tabulated-list-entries
                (org-auto-scheduler--build-review-entries org-auto-scheduler-completed-tasks))
          (org-auto-scheduler-review-save-decisions t))
        (assert-true (and org-auto-scheduler--saved-review-decisions
                          (cl-notany (lambda (e) (plist-get (cdr e) :auto-order))
                                     org-auto-scheduler--saved-review-decisions))
                     "Test 33.4: Saving from the review buffer clears :auto-order"))
    (when (get-file-buffer file)
      (with-current-buffer (get-file-buffer file)
        (set-buffer-modified-p nil)
        (kill-buffer)))
    (delete-directory temp-dir t)))
